{
  "name": "proactur",
  "version": "1.0.0",
  "description": "ProActur AI - Asistente inteligente de reuniones, transcripción automática, extracción de tareas y sincronización con Notion",
  "author": "AndreSagrav",
  "license": "MIT",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "server": "node server/index.js",
    "client": "npm --prefix client run dev",
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue,green\" \"npm run server\" \"npm run client\"",
    "chrome:edus": "start chrome --remote-debugging-port=9222 https://edus.ccss.sa.cr/eduscitasweb/",
    "build": "npm --prefix client install && npm --prefix client run build"
  },
  "dependencies": {
    "@notionhq/client": "^2.2.15",
    "@supabase/supabase-js": "^2.116.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "msedge-tts": "^2.1.1",
    "multer": "^1.4.5-lts.1",
    "puppeteer-core": "^25.16.0"
  },
  "devDependencies": {
    "apk_sign_ts": "^1.0.1",
    "concurrently": "^9.1.0"
  }
}
